# Local/disposable values only. Never copy production credentials here.
DATABASE_URL=postgres://<db-user>:<db-password>@<db-host>:5432/<db-name>
POSTGRES_DB=receipt_collector_test
POSTGRES_USER=receipt_collector_test
POSTGRES_PASSWORD=replace-with-a-long-random-test-password
SYNC_INTERVAL_SECONDS=900
SYNC_PAGE_SIZE=50
FNS_ACCOUNT_KEY=default

# Production deployment scripts require these outside the repository.
# FINANCE_VPS_HOST=example.com
# FINANCE_VPS_USER=deploy
# FINANCE_VPS_SSH_KEY=/path/to/private/key
# RECEIPT_COLLECTOR_HOME=/opt/accountant/receipt-collector

# Test-only integration connection, normally generated by compose.test.yml.
# TEST_DATABASE_URL=postgres://receipt_collector_test:test-only-password@127.0.0.1:55432/receipt_collector_test
