[Unit]
Description=Sync FNS receipts to local PostgreSQL
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=receiptcollector
Group=receiptcollector
WorkingDirectory=/opt/accountant/receipt-collector
EnvironmentFile=/etc/finance-receipt-collector/receipt-collector.env
ExecStart=/usr/bin/node /opt/accountant/receipt-collector/bin/receipt-collector.js sync --persist-matcher --return-refund --persist-return-refund
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/accountant/receipt-collector/.receipt-collector
