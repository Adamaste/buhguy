[Unit]
Description=Backup receipt-collector PostgreSQL database
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/opt/accountant/receipt-collector/deploy/backup/receipt-collector-pg-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/receipt-collector
