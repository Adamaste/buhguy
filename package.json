{
  "name": "finance-receipt-collector",
  "version": "0.1.0",
  "description": "POC CLI for collecting and normalizing receipts from the FNS \"Moyi cheki onlayn\" service.",
  "type": "module",
  "bin": {
    "receipt-collector": "./bin/receipt-collector.js",
    "bank-ingestion-server": "./bin/bank-ingestion-server.js"
  },
  "scripts": {
    "start": "node ./bin/receipt-collector.js",
    "browser-login": "node ./bin/browser-login.js",
    "migrate": "node ./bin/receipt-collector.js migrate",
    "migrate:prod:troika-024": "node ./scripts/migrate-prod-troika-024.mjs",
    "migrate:prod:bank-only-025": "node ./scripts/migrate-prod-bank-only-025.mjs",
    "migrate:prod:bank-only-027": "node ./scripts/migrate-prod-bank-only-027.mjs",
    "normalize": "node ./bin/receipt-collector.js normalize",
    "test": "node ./scripts/test-suite.js",
    "test:unit": "node ./scripts/test-suite.js --unit-only",
    "test:integration": "node ./scripts/test-postgres-integration.js",
    "test:observation-locking": "node ./scripts/run-observation-locking-clone.mjs",
    "check": "node --check ./bin/receipt-collector.js",
    "coverage:gate": "node ./bin/receipt-collector.js coverage summary",
    "coverage:clone": "node ./scripts/run-accounting-coverage-gate.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "playwright": "^1.62.1"
  }
}
