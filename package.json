{
  "name": "finance-receipt-collector",
  "version": "0.1.0",
  "description": "POC CLI for collecting and normalizing receipts from the FNS \"Moyi cheki onlayn\" service.",
  "type": "module",
  "bin": {
    "receipt-collector": "./bin/receipt-collector.js",
    "bank-ingestion-server": "./bin/bank-ingestion-server.js"
  },
  "scripts": {
    "start": "node ./bin/receipt-collector.js",
    "browser-login": "node ./bin/browser-login.js",
    "migrate": "node ./bin/receipt-collector.js migrate",
    "normalize": "node ./bin/receipt-collector.js normalize",
    "test": "node --test --test-concurrency=1 ./tests/client.test.js ./tests/cli.test.js ./tests/fiscal-evidence.test.js ./tests/fiscal-normalization.test.js ./tests/fns-detail-errors.test.js ./tests/logger.test.js ./tests/normalize.test.js ./tests/operation-type.test.js ./tests/source-identity.test.js ./tests/session-store.test.js ./tests/sync.test.js ./tests/business-event-graph.test.js ./tests/prepayment-settlement-matcher.test.js ./tests/return-refund-research.test.js ./tests/return-refund-matcher.test.js ./tests/ledger.test.js ./tests/certification.test.js ./tests/analytics.test.js ./tests/purchase-details-analytics.test.js ./tests/accounting-coverage.test.js ./tests/standalone-purchase.test.js ./tests/multi-user-fns.test.js ./tests/fns-user-onboarding.test.js ./tests/accounting-pipeline.test.js ./tests/bank-ingestion.test.js ./tests/bank-device-auth.test.js ./tests/bank-ingestion-http.test.js ./tests/bank-device-runtime.test.js ./tests/android-bank-envelope.test.js ./tests/chatgpt-accounting-semantic-layer.test.js ./tests/ledger-postgres.integration.test.js ./tests/certification-postgres.integration.test.js ./tests/analytics-postgres.integration.test.js ./tests/purchase-details-analytics-postgres.integration.test.js ./tests/bank-ingestion-postgres.integration.test.js ./tests/bank-device-auth-postgres.integration.test.js",
    "test:integration": "node ./scripts/test-postgres-integration.js",
    "test:observation-locking": "node ./scripts/run-observation-locking-clone.mjs",
    "check": "node --check ./bin/receipt-collector.js",
    "coverage:gate": "node ./bin/receipt-collector.js coverage summary",
    "coverage:clone": "node ./scripts/run-accounting-coverage-gate.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "playwright": "^1.62.1"
  }
}
